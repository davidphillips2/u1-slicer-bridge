<?xml version="1.0"?>
<Container version="2">
  <Name>u1-slicer-bridge-api</Name>
  <Repository>ghcr.io/davidphillips2/u1-slicer-bridge-api</Repository>
  <Registry>https://github.com/davidphillips2/u1-slicer-bridge/pkgs/container/u1-slicer-bridge-api</Registry>
  <Network>u1-slicer-bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/davidphillips2/u1-slicer-bridge</Support>
  <Project>https://github.com/taylormadearmy/u1-slicer-bridge</Project>
  <Overview>FastAPI backend for U1 Slicer Bridge. Handles file uploads, slicing via OrcaSlicer, and printer communication. Requires the DB container to be running first.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8000]/docs</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/davidphillips2/u1-slicer-bridge/master/templates/u1-slicer-bridge-api.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/taylormadearmy/u1-slicer-bridge/master/templates/icon.png</Icon>

  <Config Name="API Port" Target="8000" Default="8000" Description="API server port" Type="Port" Display="always" Required="true" Mode="tcp">8000</Config>
  <Config Name="Database URL" Target="DATABASE_URL" Default="postgresql://u1slicer:u1slicer@u1-slicer-bridge-db:5432/u1slicer" Description="Postgres connection string (use the DB container name as host)" Type="Variable" Display="always" Required="true" Mask="false">postgresql://u1slicer:u1slicer@u1-slicer-bridge-db:5432/u1slicer</Config>
  <Config Name="Moonraker URL" Target="MOONRAKER_URL" Default="" Description="Printer Moonraker URL, e.g. http://192.168.1.100:7125" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Allowed Origins" Target="ALLOWED_ORIGINS" Default="" Description="CORS allowed origins (blank = allow all)" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Data Storage" Target="/data" Default="/mnt/user/appdata/u1-slicer-bridge/data" Description="Slicer data, uploaded files, logs" Type="Path" Display="always" Required="true" Mode="rw">/mnt/user/appdata/u1-slicer-bridge/data</Config>
</Container>
